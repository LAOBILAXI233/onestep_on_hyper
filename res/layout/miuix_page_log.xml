<?xml version="1.0" encoding="utf-8"?>
<!-- 日志页：诊断记录卡（开关 + 文件详情 + 操作按钮）+ 复现流程信息卡 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/MiuixSectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/miuix_section_diagnostics" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/miuix_card_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/miuix_card_padding_h"
        android:paddingEnd="@dimen/miuix_card_padding_h"
        android:paddingTop="@dimen/miuix_card_padding_v"
        android:paddingBottom="@dimen/miuix_card_padding_v">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/miuix_logging_title"
                    android:textColor="@color/miuix_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/miuix_logging_summary"
                    android:textColor="@color/miuix_text_secondary"
                    android:textSize="12sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <Switch
                android:id="@+id/miuix_switch_logging"
                style="@style/MiuixSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/miuix_logging_title" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/miuix_divider" />

        <LinearLayout
            style="@style/MiuixDetailRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/MiuixDetailKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/miuix_log_file" />

            <TextView
                android:id="@+id/miuix_log_path"
                style="@style/MiuixDetailValue"
                android:layout_width="210dp"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            style="@style/MiuixDetailRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/MiuixDetailKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/miuix_log_size" />

            <TextView
                android:id="@+id/miuix_log_size"
                style="@style/MiuixDetailValue"
                android:layout_width="210dp"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/miuix_copy_path"
                android:layout_width="0dp"
                android:layout_height="@dimen/miuix_action_button_height"
                android:layout_weight="1"
                android:background="@drawable/miuix_action_button_bg"
                android:drawableStart="@drawable/ic_lucide_copy"
                android:drawableTint="@color/miuix_accent"
                android:drawablePadding="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/miuix_copy_path"
                android:textAllCaps="false"
                android:textColor="@color/miuix_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/miuix_clear_log"
                android:layout_width="0dp"
                android:layout_height="@dimen/miuix_action_button_height"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/miuix_action_button_bg"
                android:drawableStart="@drawable/ic_lucide_trash_2"
                android:drawableTint="@color/miuix_text_secondary"
                android:drawablePadding="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/miuix_clear_log"
                android:textAllCaps="false"
                android:textColor="@color/miuix_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 复现流程信息卡 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/miuix_card_gap"
        android:background="@drawable/miuix_card_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/miuix_card_padding_v">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/miuix_icon_circle_neutral_bg"
            android:padding="12dp"
            android:src="@drawable/ic_lucide_scroll_text"
            android:tint="@color/miuix_text_secondary"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/miuix_log_flow_title"
                android:textColor="@color/miuix_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/miuix_log_flow_summary"
                android:textColor="@color/miuix_text_secondary"
                android:textSize="12sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
