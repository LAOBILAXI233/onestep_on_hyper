<?xml version="1.0" encoding="utf-8"?>
<!-- 关于页：模块信息卡 + 设计来源信息卡 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/miuix_card_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/miuix_card_padding_h"
        android:paddingEnd="@dimen/miuix_card_padding_h"
        android:paddingTop="@dimen/miuix_card_padding_v"
        android:paddingBottom="@dimen/miuix_card_padding_v">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/miuix_icon_circle_bg"
                android:padding="12dp"
                android:src="@drawable/ic_lucide_info"
                android:tint="@color/miuix_accent"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/miuix_about_title"
                    android:textColor="@color/miuix_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/miuix_about_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/miuix_text_secondary"
                    android:textSize="12sp"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/miuix_divider" />

        <LinearLayout
            style="@style/MiuixDetailRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/MiuixDetailKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/miuix_about_platform" />

            <TextView
                style="@style/MiuixDetailValue"
                android:layout_width="210dp"
                android:layout_height="wrap_content"
                android:text="@string/miuix_about_platform_value" />
        </LinearLayout>

        <LinearLayout
            style="@style/MiuixDetailRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/MiuixDetailKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/miuix_about_api" />

            <TextView
                style="@style/MiuixDetailValue"
                android:layout_width="210dp"
                android:layout_height="wrap_content"
                android:text="@string/miuix_about_api_value" />
        </LinearLayout>

        <LinearLayout
            style="@style/MiuixDetailRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="0dp">

            <TextView
                style="@style/MiuixDetailKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/miuix_about_render" />

            <TextView
                style="@style/MiuixDetailValue"
                android:layout_width="210dp"
                android:layout_height="wrap_content"
                android:text="@string/miuix_about_render_value" />
        </LinearLayout>
    </LinearLayout>

    <!-- 设计来源信息卡 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/miuix_card_gap"
        android:background="@drawable/miuix_card_bg"
        android:orientation="vertical"
        android:padding="@dimen/miuix_card_padding_v">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/miuix_about_design_title"
            android:textColor="@color/miuix_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/miuix_about_design_summary"
            android:textColor="@color/miuix_text_secondary"
            android:textSize="12sp"
            android:includeFontPadding="false" />
    </LinearLayout>
</LinearLayout>
