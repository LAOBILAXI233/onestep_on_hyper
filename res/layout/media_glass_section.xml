<?xml version="1.0" encoding="utf-8"?>
<!-- One section: a compact title row followed by the adapter-backed content.
     The clear action is an icon button with a full 44dp hit target. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_section_background"
    android:clipToPadding="false"
    android:descendantFocusability="afterDescendants"
    android:orientation="vertical"
    android:paddingBottom="@dimen/glass_section_content_padding_bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/glass_section_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/glass_section_header_padding_start"
        android:paddingEnd="@dimen/glass_section_header_padding_end">
        <TextView
            android:id="@+id/section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:textColor="@color/glass_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/section_clear"
            android:layout_width="@dimen/glass_control_size"
            android:layout_height="@dimen/glass_control_size"
            android:background="@drawable/glass_control_background"
            android:contentDescription="@string/clear"
            android:importantForAccessibility="yes"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_lucide_trash_2"
            android:tooltipText="@string/clear" />
    </LinearLayout>

    <ListView
        android:id="@+id/section_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:focusable="false"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/section_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:ellipsize="end"
        android:fontFamily="sans"
        android:maxLines="2"
        android:minHeight="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/glass_text_tertiary"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
