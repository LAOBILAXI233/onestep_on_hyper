<?xml version="1.0" encoding="utf-8"?>
<!-- SukiSU-Ultra (Miuix) 风格设置主界面：大标题头 + 分页容器 + 浮动胶囊底栏 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/miuix_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/miuix_screen_margin"
        android:paddingEnd="@dimen/miuix_screen_margin">

        <!-- Miuix 大标题头 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/miuix_page_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/miuix_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/miuix_page_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/miuix_subtitle_console"
                    android:textColor="@color/miuix_text_secondary"
                    android:textSize="13sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/miuix_version_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/miuix_tag_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:textColor="@color/miuix_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/miuix_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none"
            android:paddingBottom="112dp">

            <FrameLayout
                android:id="@+id/miuix_page_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>
    </LinearLayout>

    <!-- 浮动胶囊底栏（SukiSU FloatingBottomBar 的 View 版） -->
    <LinearLayout
        android:id="@+id/miuix_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/miuix_bottom_bar_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/miuix_bottom_bar_margin_h"
        android:layout_marginEnd="@dimen/miuix_bottom_bar_margin_h"
        android:layout_marginBottom="@dimen/miuix_bottom_bar_margin_bottom"
        android:background="@drawable/miuix_bottom_bar_bg"
        android:elevation="@dimen/miuix_bottom_bar_elevation"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/miuix_nav_control"
            style="@style/MiuixNavItem">

            <ImageView
                style="@style/MiuixNavIcon"
                android:src="@drawable/ic_lucide_house"
                android:contentDescription="@string/miuix_nav_control" />

            <TextView
                style="@style/MiuixNavLabel"
                android:text="@string/miuix_nav_control" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/miuix_nav_gesture"
            style="@style/MiuixNavItem">

            <ImageView
                style="@style/MiuixNavIcon"
                android:src="@drawable/ic_lucide_hand"
                android:contentDescription="@string/miuix_nav_gesture" />

            <TextView
                style="@style/MiuixNavLabel"
                android:text="@string/miuix_nav_gesture" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/miuix_nav_log"
            style="@style/MiuixNavItem">

            <ImageView
                style="@style/MiuixNavIcon"
                android:src="@drawable/ic_lucide_scroll_text"
                android:contentDescription="@string/miuix_nav_log" />

            <TextView
                style="@style/MiuixNavLabel"
                android:text="@string/miuix_nav_log" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/miuix_nav_about"
            style="@style/MiuixNavItem">

            <ImageView
                style="@style/MiuixNavIcon"
                android:src="@drawable/ic_lucide_info"
                android:contentDescription="@string/miuix_nav_about" />

            <TextView
                style="@style/MiuixNavLabel"
                android:text="@string/miuix_nav_about" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
