<?xml version="1.0" encoding="utf-8"?>
<com.hyper.onestep.view.SideView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:smartisanos="http://schemas.android.com/apk/res/smartisanos"
    android:id="@+id/sidebar"
    android:layout_width="48dp"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/legacy_sidebar_lists"
            layout="@layout/drag_scroll_view"
            android:visibility="gone" />
        <com.hyper.onestep.view.TaskSwitcherView
            android:id="@+id/task_switcher"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <View
            android:id="@+id/drag_task_recall"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/previous_app_icon"
            android:contentDescription="@string/drag_recall_tasks"
            android:elevation="8dp"
            android:visibility="gone" />
        <View
            android:id="@+id/right_shadow"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@drawable/right_shadow"/>
        <View
            android:id="@+id/left_shadow"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:layout_gravity="right"
            android:background="@drawable/left_shadow"/>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/exit_and_add"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/exit"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="center"/>
        <ImageView
            android:id="@+id/setting"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:src="@drawable/setting"
            android:scaleType="center"/>
    </LinearLayout>
    <com.hyper.onestep.view.DimSpaceView
        android:id="@+id/side_dim_view"
        android:background="@color/disable_dim_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.hyper.onestep.view.SideView>
