<?xml version="1.0" encoding="utf-8"?>
<!-- A restrained inner band keeps sections scannable without adding another
     heavy card treatment inside the panel. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="@dimen/glass_section_corner_radius" />
    <solid android:color="@color/glass_section_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_section_stroke" />
</shape>
