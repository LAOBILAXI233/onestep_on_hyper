<?xml version="1.0" encoding="utf-8"?>
<!-- Miuix 风开关轨道：50x28dp 大圆润胶囊，选中 = Monet 主色 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/miuix_accent" />
            <corners android:radius="14dp" />
            <size
                android:width="50dp"
                android:height="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/miuix_switch_track_off" />
            <corners android:radius="14dp" />
            <size
                android:width="50dp"
                android:height="28dp" />
        </shape>
    </item>
</selector>
