<?xml version="1.0" encoding="utf-8"?>
<!-- The floating BigBang panel: a light card with rounded top corners that sits over the
     dimmed host app, matching the original which slides up as an overlay rather than a
     full-screen page. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/text_boom_background" />
    <corners
        android:topLeftRadius="@dimen/text_boom_card_corner"
        android:topRightRadius="@dimen/text_boom_card_corner" />
</shape>
