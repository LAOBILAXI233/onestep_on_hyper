<?xml version="1.0" encoding="utf-8"?>
<!-- 浮动胶囊底栏（SukiSU FloatingBottomBar / IosLiquidGlassNavigationBar 的 View 版）：
     无 backdrop blur 时用近不透明 surface + 高光描边兜底，投影由 elevation 提供。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/miuix_bar_fill" />
    <corners android:radius="32dp" />
    <stroke
        android:width="1dp"
        android:color="@color/miuix_bar_stroke" />
</shape>
