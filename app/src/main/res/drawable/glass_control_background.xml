<?xml version="1.0" encoding="utf-8"?>
<!-- 44dp controls need a visible pressed/focused state without relying on a
     platform theme that may be absent inside SystemUI. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="@color/glass_control_disabled_fill" />
            <stroke android:width="1dp" android:color="@color/glass_control_stroke" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="@color/glass_control_pressed_fill" />
            <stroke android:width="1dp" android:color="@color/glass_control_stroke" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="@color/glass_control_pressed_fill" />
            <stroke android:width="1dp" android:color="@color/glass_control_stroke" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="@color/glass_control_fill" />
            <stroke android:width="1dp" android:color="@color/glass_control_stroke" />
        </shape>
    </item>
</selector>
