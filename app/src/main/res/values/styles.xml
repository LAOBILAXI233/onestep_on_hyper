<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="SettingTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowEnableSplitTouch">false</item>
        <item name="android:splitMotionEvents">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#3673E1</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <!-- Compose (Miuix) 配置界面主题：UI 由 MiuixTheme 自绘，主题只负责窗口基底；
         系统栏图标颜色由 Activity 的 enableEdgeToEdge 按深浅色自动处理。 -->
    <style name="MiuixSettingTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ListViewGeneralStyle">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:listSelector">@android:color/transparent</item>
        <item name="android:overScrollMode">always</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>
    <style name="ListViewGeneralStyleWithDivider">
        <item name="android:listSelector">@android:color/transparent</item>
        <item name="android:overScrollMode">always</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>
    <style name="SettingItemTitleStyle">
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">0.1</item>
        <item name="android:shadowColor">#2dffffff</item>
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:maxWidth">307dp</item>
        <item name="android:textColor">#80000000</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">30dp</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:layout_marginBottom">1dp</item>
    </style>
    <style name="SettingItemTipsStyle">
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">0.1</item>
        <item name="android:shadowColor">#2dffffff</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">13dp</item>
        <item name="android:paddingLeft">30dp</item>
        <item name="android:paddingRight">30dp</item>
        <item name="android:textColor">#80000000</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        </style>
</resources>
